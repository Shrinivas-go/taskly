# ==============================================================================
# Production Environment Secret Template
# CRITICAL: NEVER COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL
# In production, inject secrets via AWS Secrets Manager + External Secrets Operator
# or via secure CI/CD deployment pipeline.
# ==============================================================================
# Usage:
#   kubectl create secret generic todoist-secrets \
#     --namespace=todoist-prod \
#     --from-literal=DATABASE_URL="postgresql://prod_app_user:REDACTED@rds-postgres-primary.prod.internal:5432/todoist_prod?sslmode=require" \
#     --from-literal=JWT_SECRET="HIGHLY_CONFIDENTIAL_MIN_64_CHAR_HEX_STRING" \
#     --from-literal=AI_API_KEY="gsk_PRODUCTION_GROQ_KEY_REDACTED"
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: todoist-secrets
  namespace: todoist-prod
  labels:
    app.kubernetes.io/name: todoist-secrets
    environment: prod
type: Opaque
stringData:
  DATABASE_URL: "postgresql://prod_user:REPLACE_WITH_PROD_VAULT_PASSWORD@todoist-prod-db.internal:5432/todoist_prod?sslmode=require"
  JWT_SECRET: "REPLACE_WITH_SECURE_PROD_JWT_SECRET_64_CHARS"
  AI_API_KEY: "REPLACE_WITH_SECURE_PROD_AI_API_KEY"
