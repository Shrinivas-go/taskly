# ==============================================================================
# Staging Environment Secret Template
# DO NOT COMMIT ACTUAL PRODUCTION OR SENSITIVE SECRETS TO SOURCE CONTROL
# ==============================================================================
# Usage:
#   kubectl create secret generic todoist-secrets \
#     --namespace=todoist-staging \
#     --from-literal=DATABASE_URL="postgresql://user:password@staging-rds-endpoint:5432/todoist_staging?sslmode=require" \
#     --from-literal=JWT_SECRET="staging-strong-jwt-secret-min-32-chars-long" \
#     --from-literal=AI_API_KEY="staging-groq-api-key"
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: todoist-secrets
  namespace: todoist-staging
  labels:
    app.kubernetes.io/name: todoist-secrets
    environment: staging
type: Opaque
stringData:
  DATABASE_URL: "postgresql://staging_user:REPLACE_WITH_ACTUAL_STAGING_PASSWORD@todoist-staging-db.internal:5432/todoist_staging?sslmode=require"
  JWT_SECRET: "REPLACE_WITH_ACTUAL_STAGING_JWT_SECRET_32_CHARS"
  AI_API_KEY: "REPLACE_WITH_ACTUAL_STAGING_AI_API_KEY"
