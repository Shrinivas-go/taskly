# ==============================================================================
# Development Environment Secret Template
# DO NOT COMMIT ACTUAL PRODUCTION OR SENSITIVE SECRETS TO SOURCE CONTROL
# ==============================================================================
# Usage:
#   kubectl create secret generic todoist-secrets \
#     --namespace=todoist-dev \
#     --from-literal=DATABASE_URL="postgresql://postgres:postgres@postgres.todoist-dev.svc.cluster.local:5432/todoist_dev?schema=public" \
#     --from-literal=JWT_SECRET="dev-insecure-development-jwt-secret-min-32-chars-long" \
#     --from-literal=AI_API_KEY="dev-mock-or-groq-api-key"
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: todoist-secrets
  namespace: todoist-dev
  labels:
    app.kubernetes.io/name: todoist-secrets
    environment: dev
type: Opaque
stringData:
  DATABASE_URL: "postgresql://postgres:postgres@postgres.todoist-dev.svc.cluster.local:5432/todoist_dev?schema=public"
  JWT_SECRET: "dev-insecure-development-jwt-secret-min-32-chars-long"
  AI_API_KEY: "dev-mock-or-groq-api-key"
