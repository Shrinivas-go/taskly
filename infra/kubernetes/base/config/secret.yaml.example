# ==============================================================================
# Base Kubernetes Secret Template
# COPY TO secret.yaml FOR LOCAL / STAGING / PROD APPLICATION
# NEVER COMMIT REAL SECRETS OR BASE64 PRODUCTION VALUES TO SOURCE CONTROL
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: todoist-secrets
  labels:
    app.kubernetes.io/name: todoist
    app.kubernetes.io/part-of: todoist-application
type: Opaque
stringData:
  # [SECRET] PostgreSQL connection string with authentication credentials
  DATABASE_URL: "postgresql://dev:dev@postgres:5432/todoist_dev?schema=public&sslmode=disable"

  # [SECRET] High-entropy signing secret for JWT access tokens
  JWT_SECRET: "dev_jwt_secret_key_change_in_production_123456789"

  # [SECRET] Real LLM provider API key (Groq / OpenAI)
  AI_API_KEY: ""
