# Example tfvars for Development environment
# Copy to terraform.tfvars for local planning
# NEVER COMMIT SECRETS TO TFVARS

aws_region  = "us-east-1"
environment = "dev"
vpc_cidr    = "10.0.0.0/16"

availability_zones    = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.20.0/24"]
database_subnet_cidrs = ["10.0.30.0/24", "10.0.40.0/24"]

# Cost-optimization: single NAT Gateway for development
enable_nat_gateway = true
single_nat_gateway = true
