# ==============================================================================
# Todoist-Style Application - Environment Variables Template
# Copy this file to .env for local development
# NEVER COMMIT REAL SECRETS OR PRODUCTION VALUES TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# [INTERNAL] Database superuser/app user name
POSTGRES_USER=dev

# [SECRET] Database user password (CHANGE IN STAGING / PRODUCTION)
POSTGRES_PASSWORD=dev

# [INTERNAL] Database catalog name
POSTGRES_DB=todoist_dev

# [INTERNAL] Host port exposed for local dev access (default: 5432)
POSTGRES_PORT=5432

# [SECRET/INTERNAL] Full Connection String used by NestJS Prisma Client
# For Local host run:       postgresql://dev:dev@localhost:5432/todoist_dev?schema=public&sslmode=disable
# For Docker Compose:       postgresql://dev:dev@postgres:5432/todoist_dev?schema=public&sslmode=disable
# For Free Neon / Supabase: postgresql://<user>:<password>@<neon-or-supabase-host>:5432/<db>?sslmode=require
DATABASE_URL=postgresql://dev:dev@localhost:5432/todoist_dev?schema=public&sslmode=disable

# [SECRET/INTERNAL] Isolated database for automated test suite execution
DATABASE_URL_TEST=postgresql://dev:dev@localhost:5432/todoist_test?schema=public&sslmode=disable

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (NestJS)
# ------------------------------------------------------------------------------
# [INTERNAL] Internal and listening port for NestJS server
PORT=4000
BACKEND_PORT=4000

# [INTERNAL] Application environment: development | test | production
NODE_ENV=development

# [INTERNAL] Global URL prefix for API routes (default: api/v1)
API_PREFIX=api/v1

# [INTERNAL] Allowed origins for CORS (comma-separated). In production, set to your Vercel URL
CORS_ORIGINS=https://taskly-7w61.vercel.app
FRONTEND_URL=https://taskly-7w61.vercel.app

# [SECRET] High-entropy signing secret for JWT access tokens (CHANGE IN PRODUCTION)
JWT_SECRET=dev_jwt_secret_key_change_in_production_123456789

# [INTERNAL] Expiry window for JWT access tokens
JWT_EXPIRES_IN=7d

# [OAUTH] Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=110254728311-acfug1luj2l7m68l3katijarqtmb01mu.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://taskly-backend-rsdd.onrender.com/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
# [INTERNAL] Listening port for Next.js HTTP server
FRONTEND_PORT=3000

# [PUBLIC] Base API URL accessed by client-side browser fetches
# In production: https://taskly-backend-rsdd.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://taskly-backend-rsdd.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 4. AI MICROSERVICE CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
# [INTERNAL] Host and port for FastAPI AI server
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# [INTERNAL] Base URL for backend-to-AI microservice calls
# In production: https://taskly-ai.onrender.com
AI_SERVICE_URL=https://taskly-ai.onrender.com

# [INTERNAL] Request timeout in milliseconds (default: 35000ms)
AI_SERVICE_TIMEOUT=35000

# [INTERNAL] Active AI provider: "mock" (default, deterministic) | "openai" (OpenAI / Groq)
AI_PROVIDER=mock

# [SECRET] Real LLM provider API key (NEVER expose to frontend or commit to git)
AI_API_KEY=

# [INTERNAL] Model identifier (e.g. gpt-4o-mini or qwen/qwen3.8-27b)
AI_MODEL=gpt-4o-mini

# [INTERNAL] Optional base URL override for OpenAI-compatible providers
AI_BASE_URL=
